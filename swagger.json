                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "invalidBookData": {
                    "summary": "Invalid fields, additional fields, or nonexistent author ID",
                    "value": {
                      "message": "Invalid book data."
                    }
                  },
                  "malformedJson": {
                    "summary": "Malformed JSON request body",
                    "value": {
                      "message": "Malformed JSON request body."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
