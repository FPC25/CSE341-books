                      "format": "date"
                    }
                  }
                },
                "example": {
                  "_id": "665f1a2b3c4d5e6f7a8b9c0d",
                  "id": "b1",
                  "authorId": "a1",
                  "title": "Updated Book Title",
                  "publishedDate": "2022-09-02"
                }
              }
            }
          },
          "400": {
            "description": "Invalid book data or malformed JSON",
