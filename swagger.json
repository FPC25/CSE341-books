{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Get all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "List of books",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "description": "MongoDB document identifier"
                      },
                      "id": {
                        "type": "string"
                      },
                      "authorId": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "publicationDate": {
                        "type": "string",
                        "format": "date"
                      }
                    },
                    "required": [
                      "id",
                      "authorId",
                      "title",
                      "publicationDate",
                      "_id"
                    ]
                  }
                },
                "example": [
                  {
                    "_id": "665f1a2b3c4d5e6f7a8b9c0d",
                    "id": "b1",
                    "authorId": "a1",
                    "title": "A book title",
                    "publicationDate": "2022-09-02"
                  },
                  {
                    "_id": "665f1a2b3c4d5e6f7a8b9c0e",
                    "id": "b2",
                    "authorId": "a1",
                    "title": "Another book title",
                    "publicationDate": "2002-12-27"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal Server Error"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "authorId",
                  "title",
                  "publishedDate"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 2,
                    "example": "b4",
                    "description": "Custom book ID; trimmed and non-empty string;HTML characters are escaped before storage."
                  },
                  "authorId": {
                    "type": "string",
                    "minLength": 2,
                    "example": "a1",
                    "description": "Must match the custom ID of an existing author."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "Example Book Title",
                    "description": "Trimmed, non-empty string; HTML characters are escaped before storage."
                  },
                  "publishedDate": {
                    "type": "string",
                    "format": "ISO8601 date",
                    "example": "2026-01-15"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book inserted into MongoDB",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "acknowledged",
                    "insertedId"
                  ],
                  "properties": {
                    "acknowledged": {
                      "type": "boolean",
                      "example": true
                    },
                    "insertedId": {
                      "type": "string",
                      "description": "MongoDB-generated document identifier",
                      "example": "665f1a2b3c4d5e6f7a8b9c0d"
                    }
                  }
                },
                "example": {
                  "acknowledged": true,
                  "insertedId": "665f1a2b3c4d5e6f7a8b9c0d"
                }
              }
            }
          },
          "400": {
            "description": "Invalid book data or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "invalidBookData": {
                    "summary": "Missing or invalid fields, unknown fields, or nonexistent author ID",
                    "value": {
                      "message": "Invalid book data."
                    }
                  },
                  "malformedJson": {
                    "summary": "Malformed JSON request body",
                    "value": {
                      "message": "Malformed JSON request body."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A book with this ID already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "The request conflicts with existing data."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server or database error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal Server Error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
